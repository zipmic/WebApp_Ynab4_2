# Budget Reborn configuration (all optional). Copy to a file OUTSIDE any public web folder and load it with
# your process manager (systemd EnvironmentFile=, pm2 ecosystem, hosting control panel). Never commit real values.

# Where budgets, backups and the login database live. Must NOT be inside a web-served directory.
BR_DATA_DIR=/var/lib/budget-reborn
# Address and port to listen on. Keep 127.0.0.1 when a reverse proxy (nginx/Apache/Caddy) is in front.
BR_HOST=127.0.0.1
BR_PORT=8787
# Behind a reverse proxy that terminates HTTPS: trust its X-Forwarded-* headers and require HTTPS.
BR_TRUST_PROXY=1
BR_REQUIRE_HTTPS=1
# Public address of the app; needed for passkeys behind a proxy.
BR_PUBLIC_ORIGIN=https://budget.example.com
# Optional VPN-only mode: comma-separated client addresses or prefixes that may connect at all.
# BR_ALLOWED_NETWORKS=10.8.0.,100.64.,127.0.0.1
# Sessions: idle timeout (minutes) and absolute lifetime (days).
BR_SESSION_IDLE_MINUTES=10080
BR_SESSION_MAX_DAYS=30
# Number of automatic daily backups to keep per budget.
BR_BACKUP_KEEP=30

# OPTIONAL external vision AI for difficult screenshots (off unless set; each use still asks for consent in the app).
# Any OpenAI-compatible endpoint works, including a self-hosted one (e.g. Ollama: http://127.0.0.1:11434/v1).
# BR_VISION_BASE_URL=https://api.openai.com/v1
# BR_VISION_API_KEY=
# BR_VISION_MODEL=gpt-4o-mini
