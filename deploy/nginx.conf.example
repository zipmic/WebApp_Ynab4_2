# HTTPS reverse proxy for Budget Reborn. The Node process listens on 127.0.0.1 only.
server {
    listen 80;
    server_name budget.example.com;
    return 308 https://$host$request_uri;
}
server {
    listen 443 ssl http2;
    server_name budget.example.com;
    ssl_certificate     /etc/letsencrypt/live/budget.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/budget.example.com/privkey.pem;
    client_max_body_size 600m;            # YNAB4 budgets and backup restores can be large

    # Optional VPN-only access: uncomment and list your VPN range.
    # allow 10.8.0.0/24; deny all;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
