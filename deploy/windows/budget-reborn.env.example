# Budget Reborn - indstillinger til en Windows-computer derhjemme.
# Kopier filen til C:\BudgetReborn\budget-reborn.env (UDEN for app-mappen) og ret værdierne.
# Linjer der starter med # er kommentarer.

# Hvor budgetter, backups og login gemmes. Skal ligge uden for app-mappen.
BR_DATA_DIR=C:\BudgetReborn\data

# Appen lytter kun på computeren selv. Tailscale sender trafikken videre hertil.
BR_HOST=127.0.0.1
BR_PORT=8787

# Den HTTPS-adresse Tailscale giver din computer (se vejledningen, trin 5).
# Fjern # foran linjen, når du kender adressen. Nødvendig for login fra telefonen og for passkeys.
# BR_PUBLIC_ORIGIN=https://din-pc.dit-tailnet.ts.net

# Antal automatiske backups der gemmes pr. budget.
BR_BACKUP_KEEP=30

# Ekstra kopi af den daglige backup, fx en USB-disk eller en anden disk. Fjern # og ret stien.
# Kopierne indeholder alle dine økonomidata ukrypteret: brug et privat sted.
# BR_BACKUP_COPY_TO=E:\BudgetReborn-backup
